# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. on Vercel: https://my-app.vercel.app)
APP_URL="MY_APP_URL"

# CÁBALA Football Data Provider Configuration
# Default is 'espn' (Official Argentine LPF public API, no key required)
