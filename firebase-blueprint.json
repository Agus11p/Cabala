{
  "entities": {
    "SeasonConfig": {
      "title": "Season Configuration",
      "description": "Configuration metadata for an AFA Primera División season",
      "type": "object",
      "properties": {
        "seasonYear": { "type": "string" },
        "name": { "type": "string" },
        "teamsCount": { "type": "number" },
        "activeCompetitions": { "type": "array" },
        "rulesVersion": { "type": "string" }
      },
      "required": ["seasonYear", "name", "teamsCount"]
    },
    "CompetitionRule": {
      "title": "Competition Ruleset",
      "description": "Deterministic competition rules for a tournament (Apertura, Clausura, Anual, etc.)",
      "type": "object",
      "properties": {
        "competitionId": { "type": "string" },
        "seasonYear": { "type": "string" },
        "format": { "type": "string" },
        "zonesCount": { "type": "number" },
        "teamsPerZone": { "type": "number" },
        "regularRounds": { "type": "number" },
        "playoffQualifiersPerZone": { "type": "number" },
        "rulesSummary": { "type": "string" }
      },
      "required": ["competitionId", "seasonYear", "format"]
    },
    "TeamRecord": {
      "title": "Club Entity",
      "description": "Normalized Primera División team entity with provenance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "shortName": { "type": "string" },
        "code": { "type": "string" },
        "city": { "type": "string" },
        "stadium": { "type": "string" },
        "logo": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "zone": { "type": "string" },
        "provenance": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "code"]
    },
    "MatchRecord": {
      "title": "Match Entity",
      "description": "Normalized Primera División fixture match record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tournament": { "type": "string" },
        "round": { "type": "string" },
        "homeTeamId": { "type": "string" },
        "awayTeamId": { "type": "string" },
        "homeScore": { "type": "number" },
        "awayScore": { "type": "number" },
        "status": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "stadium": { "type": "string" },
        "referee": { "type": "string" },
        "provenance": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "homeTeamId", "awayTeamId", "status", "date"]
    },
    "ZoneStandingsRecord": {
      "title": "Zone Standings Record",
      "description": "Official standings table for a single zone with verified balance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "seasonYear": { "type": "string" },
        "phase": { "type": "string" },
        "zone": { "type": "string" },
        "entries": { "type": "array" },
        "provenance": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "seasonYear", "phase", "zone", "entries"]
    },
    "AnnualStandingsRecord": {
      "title": "Annual Standings Record",
      "description": "Official annual accumulated table for all 30 teams",
      "type": "object",
      "properties": {
        "seasonYear": { "type": "string" },
        "entries": { "type": "array" },
        "provenance": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["seasonYear", "entries"]
    },
    "DataSourceRecord": {
      "title": "Data Source Record",
      "description": "Registered data provider status and metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "rateLimitPerMinute": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "type", "status"]
    },
    "DataIngestionRunRecord": {
      "title": "Data Ingestion Run Log",
      "description": "Log of ingestion runs, validations and record counts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sourceId": { "type": "string" },
        "startedAt": { "type": "string" },
        "completedAt": { "type": "string" },
        "recordsIngested": { "type": "number" },
        "recordsVerified": { "type": "number" },
        "inconsistenciesCount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "sourceId", "status"]
    },
    "UserCabalaProfile": {
      "title": "User Profile",
      "description": "User profile with favorite club and competitive stats",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string", "maxLength": 50 },
        "favoriteClubId": { "type": "string", "maxLength": 64 },
        "elo": { "type": "number" },
        "rankTitle": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "username"]
    },
    "AiFootballQuery": {
      "title": "AI Football Query Log",
      "description": "Log of user football queries and tool grounded answers",
      "type": "object",
      "properties": {
        "queryId": { "type": "string" },
        "userId": { "type": "string" },
        "query": { "type": "string", "maxLength": 1000 },
        "modelUsed": { "type": "string" },
        "toolsCalled": { "type": "array" },
        "timestamp": { "type": "string" }
      },
      "required": ["queryId", "query", "modelUsed"]
    }
  },
  "firestore": {
    "/seasons/{seasonYear}": {
      "schema": "SeasonConfig",
      "description": "Official seasons config"
    },
    "/rules/{ruleId}": {
      "schema": "CompetitionRule",
      "description": "Competition official regulations"
    },
    "/teams/{teamId}": {
      "schema": "TeamRecord",
      "description": "Official Primera División clubs repository"
    },
    "/matches/{matchId}": {
      "schema": "MatchRecord",
      "description": "Fixtures, live and completed matches"
    },
    "/standings/{standingId}": {
      "schema": "ZoneStandingsRecord",
      "description": "Apertura and Clausura verified zone standings"
    },
    "/annual_standings/{seasonYear}": {
      "schema": "AnnualStandingsRecord",
      "description": "Annual 30-club accumulated standings"
    },
    "/data_sources/{sourceId}": {
      "schema": "DataSourceRecord",
      "description": "Tracked external data sources"
    },
    "/data_ingestion_runs/{runId}": {
      "schema": "DataIngestionRunRecord",
      "description": "Ingestion execution history and provenance runs"
    },
    "/users/{userId}": {
      "schema": "UserCabalaProfile",
      "description": "Public user profile and favorite club"
    },
    "/ai_queries/{queryId}": {
      "schema": "AiFootballQuery",
      "description": "User interaction with Cábala AI Assistant"
    }
  }
}
