rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isServerAuthorized() {
      return request.resource.data.serverToken == 'cabala_server_internal_token_2026';
    }

    // Official regulations & seasons metadata: public read-only, server-write only
    match /seasons/{seasonYear} {
      allow read: if true;
      allow write: if isValidId(seasonYear) && isServerAuthorized();
    }

    match /rules/{ruleId} {
      allow read: if true;
      allow write: if isValidId(ruleId) && isServerAuthorized();
    }

    // Official clubs registry: public read-only, server-write only
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isValidId(teamId) && isServerAuthorized();
    }

    // Fixtures, live and completed matches: public read-only, server-write only
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isValidId(matchId) && isServerAuthorized();
    }

    // Zone standings (Apertura and Clausura): public read-only, server-write only
    match /standings/{standingId} {
      allow read: if true;
      allow write: if isValidId(standingId) && isServerAuthorized();
    }

    // Annual 30-club accumulated standings: public read-only, server-write only
    match /annual_standings/{seasonYear} {
      allow read: if true;
      allow write: if isValidId(seasonYear) && isServerAuthorized();
    }

    // Data sources metadata: public read-only, server-write only
    match /data_sources/{sourceId} {
      allow read: if true;
      allow write: if isValidId(sourceId) && isServerAuthorized();
    }

    // Ingestion runs history: public read-only, server-write only
    match /data_ingestion_runs/{runId} {
      allow read: if true;
      allow write: if isValidId(runId) && isServerAuthorized();
    }

    // User Profile
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.username is string &&
        request.resource.data.username.size() <= 50;
      allow update: if isOwner(userId) && isValidId(userId) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.username is string &&
        request.resource.data.username.size() <= 50;
      allow delete: if false;
    }

    // AI queries log
    match /ai_queries/{queryId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(queryId) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.query is string &&
        request.resource.data.query.size() <= 1000;
      allow update, delete: if false;
    }
  }
}
