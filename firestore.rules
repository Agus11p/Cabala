rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Official regulations & seasons metadata: public read-only
    match /seasons/{seasonYear} {
      allow read: if isValidId(seasonYear);
      allow write: if false;
    }

    match /rules/{ruleId} {
      allow read: if isValidId(ruleId);
      allow write: if false;
    }

    // User Profile
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.username is string &&
        request.resource.data.username.size() <= 50;
      allow update: if isOwner(userId) && isValidId(userId) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.username is string &&
        request.resource.data.username.size() <= 50;
      allow delete: if false;
    }

    // AI queries log
    match /ai_queries/{queryId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(queryId) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.query is string &&
        request.resource.data.query.size() <= 1000;
      allow update, delete: if false;
    }
  }
}
